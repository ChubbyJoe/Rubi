{
  "name": "rubi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "tsx scripts/migrate.ts && next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:check": "drizzle-kit check",
    "db:check-model": "tsx --env-file=.env.local scripts/check-data-model.ts",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "db:setup-roles": "tsx --env-file=.env.local scripts/setup-roles.ts",
    "auth:generate": "SKIP_ENV_VALIDATION=1 npx auth@latest generate --config src/lib/auth/index.ts --output src/lib/db/schema/auth.ts --yes && tsx scripts/auth-schema-tz.ts && prettier --write src/lib/db/schema/auth.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db"
  },
  "dependencies": {
    "@t3-oss/env-nextjs": "^0.13.11",
    "@vercel/functions": "^3.10.3",
    "better-auth": "^1.7.12",
    "drizzle-orm": "^0.45.4",
    "libphonenumber-js": "^1.13.15",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "24.x"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
