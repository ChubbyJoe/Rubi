# Copy to .env.local for local work. Never commit real values.

# Neon (injected per branch by the Neon/Vercel integration; set by hand locally)
PGHOST=                     # pooled host, ends in -pooler...
PGHOST_UNPOOLED=            # direct host
PGDATABASE=rubi
RUBI_APP_DB_PASSWORD=       # password of the rubi_app runtime role
DATABASE_URL_UNPOOLED=      # owner role, direct; migrations and setup only

# Better Auth (one secret per environment: openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000        # previews: derived from VERCEL_BRANCH_URL; production: falls back to the production domain
NEXT_PUBLIC_APP_URL=http://localhost:3000    # derived from VERCEL_BRANCH_URL in previews

# Cloudflare R2 (optional until Add a product, feature 6)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=rubi-images-dev
NEXT_PUBLIC_IMAGE_BASE_URL=

# GitHub Actions secrets only (throwaway CI branches)
# NEON_API_KEY=
# NEON_PROJECT_ID=

# LOG_LEVEL=info
